query_resource_content() 在给定资料范围内使用rag技术进行内容查询 \n\n5. 返回格式\n\n严格按照以下json格式返回，不允许包含无关内容\n\n{\n  "content": "必填：文字对话内容",\n  "buttons": [\n    {\n      "show_text": "按钮显示文字",\n      "send_text": "点击后自动发送到后台的文字，要求文字简洁，发送内容为指令，不允许包含主语"\n    }\n  ],\n  "resources": [\n    {\n      "show_text": "资料显示名称",\n      "id": "资料唯一ID"\n    }\n  ],\n  "tests": [\n    {\n      "show_text": "测验显示名称",\n      "id": "测验唯一ID"\n    }\n  ]\n}\n\nYou are an agent. Your internal name is "engagement". The description about you is "5E教学模型 Engagement 阶段智能体".'}, {'role': 'user', 'content': '开始学习'}, {'role': 'user', 'content': '开始学习'}, {'role': 'assistant', 'content': '              ', 'tool_calls': [{'type': 'function', 'id': 'call_00_jdKMezufcLcqg1MG7klu1980', 'function': {'name': 'is_first_learn', 'arguments': '{"user_id": "current_user", "course_id": "current_course"}'}}, {'type': 'function', 'id': 'call_01_hHG7LfSZPpTKVsR69uaq4190', 'function': {'name': 'get_course_detail', 'arguments': '{"course_id": "current_course"}'}}, {'type': 'function', 'id': 'call_02_vqwCXJAAf9Dl2ybvY5F98104', 'function': {'name': 'get_learned_courses', 'arguments': '{"student_id": "current_user"}'}}]}, {'role': 'tool', 'tool_call_id': 'call_00_jdKMezufcLcqg1MG7klu1980', 'content': '{"result": false}'}, {'role': 'tool', 'tool_call_id': 'call_01_hHG7LfSZPpTKVsR69uaq4190', 'content': '{"result": ["", ""]}'}, {'role': 'tool', 'tool_call_id': 'call_02_vqwCXJAAf9Dl2ybvY5F98104', 'content': '{"result": []}'}, {'role': 'assistant', 'tool_calls': [{'type': 'function', 'id': 'call_00_JzpVeh861XIkpf5XgbBj8512', 'function': {'name': 'get_course_detail', 'arguments': '{"course_id": "current_course"}'}}, {'type': 'function', 'id': 'call_01_jkes5XDPDKGVGEYR4AWj5264', 'function': {'name': 'get_related_course', 'arguments': '{"course_id": "current_course"}'}}]}, {'role': 'tool', 'tool_call_id': 'call_00_JzpVeh861XIkpf5XgbBj8512', 'content': '{"result": ["", ""]}'}, {'role': 'tool', 'tool_call_id': 'call_01_jkes5XDPDKGVGEYR4AWj5264', 