e': 'assistant', 'content': '                                                                                                                                                                                                                                                                                                                                                                                                                                              ', 'tool_calls': [{'type': 'function', 'id': 'call_00_3rDzd77ebhCGGWdSAqJ22894', 'function': {'name': 'get_course_resources', 'arguments': '{"course_id": "session_id"}'}}]}, {'role': 'tool', 'tool_call_id': 'call_00_3rDzd77ebhCGGWdSAqJ22894', 'content': '{"result": []}'}, {'role': 'assistant', 'content': '{\n  "content": "你上次打开过这里，相信你对这部分的画面还留有一些印象。今天想邀请你用一个全新的角度再看它一眼。回想一下，你最近一次留意到身边的某个“条件”或“规则”在悄悄决定结果，是什么时候？",\n  "buttons": [\n    {\n      "show_text": "接着聊聊",\n      "send_text": "接着聊聊"\n    }\n  ],\n  "resources": [],\n  "tests": []\n}'}, {'role': 'user', 'content': '接着聊聊'}], 'response_format': {'type': 'json_object'}, 'tools': [{'type': 'function', 'function': {'name': 'is_first_learn', 'description': '', 'parameters': {'properties': {'user_id': {'title': 'User Id', 'type': 'string'}, 'course_id': {'title': 'Course Id', 'type': 'string'}}, 'required': ['user_id', 'course_id'], 'title': 'is_first_learnParams', 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'get_course_detail', 'description': '', 'parameters': {'properties': {'course_id': {'title': 'Course Id', 'type': 'string'}}, 'required': ['course_id'], 'title': 'get_course_detailParams', 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'get_related_course', 'description': '', 'parameters': {'properties': {'course_id': {'title': 'Course Id', 'type': 'string'}}, 'required': ['course_id'], 'title': 'get_related_courseParams', 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'get_learned_courses', 'description': '', 'par